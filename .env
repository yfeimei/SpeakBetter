# Public site configuration.
#
# CHANGE THIS to the domain you actually deploy to. It is baked into the
# canonical link and the Open Graph tags at build time, so social previews and
# search engines point at the right place.
#
# No trailing slash.
VITE_SITE_URL=https://speakbetter.com

# Domain written into dist/CNAME by the post-build step. GitHub Pages needs
# this file; Netlify, Vercel and Cloudflare ignore it harmlessly.
# Leave empty if you are not deploying to GitHub Pages.
DEPLOY_DOMAIN=
